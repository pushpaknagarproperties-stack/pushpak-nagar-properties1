  "profiles": [
    {
      "name": "admin",
      "label": "Admin Full Access + File Storage Full",
      "permissions": {
        "projects_c": "full_file_access",
        "properties_c": "full_file_access",
        "media_library_c": "full_file_access",
        "leads_c": "full"
      }
    },
    {
      "name": "public",
      "label": "Public Read + File Download",
      "permissions": {
        "projects_c": "read_file_download",
        "properties_c": "read_file_download",
        "media_library_c": "read_file_download"
      }
    }
  ],
  "rlsPolicies": [
    {
      "table": "projects_c",
      "policy": "File Storage RLS - Public can read + download files, Admin full CRUD + upload",
      "rules": [
        {
          "action": "read_files",
          "role": "public",
          "allowed": true,
          "fields": [
            "main_image_c",
            "gallery_images_c",
            "floor_plans_c",
            "brochures_c",
            "cost_sheets_c",
            "maps_c",
            "videos_c",
            "rera_documents_c",
            "cidco_noc_c",
            "elevation_images_c",
            "master_plans_c",
            "downloadable_media_c"
          ]
        },
        {
          "action": "upload_files",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "delete_files",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "download_files",
          "role": "public",
          "allowed": true
        }
      ],
      "enabled": true
    },
    {
      "table": "properties_c",
      "policy": "File Storage RLS - Same as projects_c",
      "rules": [
        {
          "action": "read_files",
          "role": "public",
          "allowed": true
        },
        {
          "action": "upload_files",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "download_files",
          "role": "public",
          "allowed": true
        }
      ],
      "enabled": true
    },
    {
      "table": "media_library_c",
      "policy": "Media Library File RLS - Public read download, Admin full",
      "rules": [
        {
          "action": "read_files",
          "role": "public",
          "allowed": true
        },
        {
          "action": "download_files",
          "role": "public",
          "allowed": true
        },
        {
          "action": "upload_files",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "delete_files",
          "role": "admin",
          "allowed": true
        }
      ],
      "enabled": true
    },
    {
      "table": "leads_c",
      "policy": "Leads RLS - Admin only + CRM routing",
      "rules": [
        {
          "action": "create",
          "role": "public",
          "allowed": true,
          "description": "Public can create lead via Book Visit form"
        },
        {
          "action": "read",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "update",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "delete",
          "role": "admin",
          "allowed": true
        }
      ],
      "enabled": true
    },
    {
      "table": "projects_c",
      "policy": "Projects CRUD RLS",
      "rules": [
        {
          "action": "read",
          "role": "public",
          "allowed": true
        },
        {
          "action": "create",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "update",
          "role": "admin",
          "allowed": true
        },
        {
          "action": "delete",
          "role": "admin",
          "allowed": true
        }
      ],
      "enabled": true
    }
  ],
  "fileStorageConfig": {
    "provider": "Apper Real File Storage + Cloudflare R2",
    "bucket": "pushpak-v46-media",
    "r2_endpoint": "https://r2.pushpaknagarproperties.org",
    "apper_file_system": true,
    "not_faked": "All file fields use Apper File type, not Text or JSON with [\"front.jpg\"]",
    "fields_real_file_storage": [
      "projects_c.main_image_c File Image max 1",
      "projects_c.gallery_images_c File Image max 20",
      "projects_c.floor_plans_c File Document max 10 PDF",
      "projects_c.brochures_c File Document max 10 PDF",
      "projects_c.cost_sheets_c File Document max 5",
      "projects_c.maps_c File Image max 5",
      "projects_c.videos_c File Video max 5 mp4",
      "projects_c.rera_documents_c File Document max 5 PDF",
      "projects_c.cidco_noc_c File Document max 5 PDF",
      "projects_c.elevation_images_c File Image max 10",
      "projects_c.master_plans_c File Document max 5",
      "projects_c.downloadable_media_c File Mixed max 20",
      "properties_c.main_image_c File Image",
      "properties_c.gallery_images_c File Image max 20",
      "properties_c.floor_plans_c File Document",
      "properties_c.brochures_c File Document",
      "media_library_c.file_c File Mixed - real 247 media"
    ]
  }
