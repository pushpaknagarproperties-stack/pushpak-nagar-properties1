        {
          "name": "main_image_c",
          "label": "Main Project Image - Real File Storage",
          "type": "File",
          "fileType": "Image",
          "maxFiles": 1,
          "allowedTypes": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/avif"
          ],
          "storage": "Apper File Storage + R2 pushpak-v46-media",
          "required": true,
          "description": "Real file-storage, not text path front.jpg - Apper File field"
        },
        {
          "name": "gallery_images_c",
          "label": "Gallery Images - Real File Storage 4 Images",
          "type": "File",
          "fileType": "Image",
          "maxFiles": 20,
          "allowedTypes": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/avif"
          ],
          "storage": "Apper File Storage + R2 pushpak-v46-media/gallery/",
