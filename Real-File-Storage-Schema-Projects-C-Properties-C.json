{
  "projectId": "8b7b933255624300a16890aebed9ba46",
  "dataStoreId": 1,
  "appIcon": "https://pushpaknagarproperties.org/favicon.ico",
  "message": "Production-live real file-storage - not faked into text fields",
  "tables": [
    {
      "name": "projects_c",
      "label": "Projects",
      "description": "Real projects table with Apper file-storage system - not json text",
      "fields": [
        {
          "name": "Name",
          "label": "Project Name",
          "type": "Text",
          "required": true,
          "length": 255
        },
        {
          "name": "project_id_c",
          "label": "Project ID",
          "type": "Text",
          "required": true,
          "unique": true,
          "examples": [
            "PNP001",
            "COM001",
            "OFF001",
            "RNT001",
            "RSL001"
          ]
        },
        {
          "name": "type_c",
          "label": "Type",
          "type": "Picklist",
          "values": [
            "Sale",
            "Rental",
            "Resale",
            "Commercial"
          ],
          "required": true
        },
        {
          "name": "price_c",
          "label": "Price Display",
          "type": "Text",
          "examples": [
            "42L",
            "45L",
            "12K/mo",
            "1.2Cr"
          ]
        },
        {
          "name": "priceL_c",
          "label": "Price Lacs Number",
          "type": "Number",
          "precision": 2
        },
        {
          "name": "location_c",
          "label": "Location Sector",
          "type": "Text",
          "examples": [
            "Sector-1 to Sector-10"
          ]
        },
        {
          "name": "bhk_c",
          "label": "BHK Type",
          "type": "Picklist",
          "values": [
            "1BHK",
            "2BHK",
            "3BHK",
            "Shop",
            "Office"
          ],
          "required": true
        },
        {
          "name": "description_c",
          "label": "Full Description Premium V46",
          "type": "LongTextArea",
          "length": 5000
        },
        {
          "name": "rera_number_c",
          "label": "RERA Number",
          "type": "Text"
        },
        {
          "name": "cidco_approved_c",
          "label": "CIDCO Approved",
          "type": "Checkbox",
          "default": true
        },
        {
          "name": "ready_possession_c",
          "label": "Ready Possession",
          "type": "Checkbox"
        },
        {
          "name": "enabled_c",
          "label": "Enabled",
          "type": "Checkbox",
          "default": true
        },
        {
          "name": "featured_c",
          "label": "Featured Premium",
          "type": "Checkbox"
